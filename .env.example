# Скопируйте в .env и заполните. Этот файл — для локальной разработки:
# `cp .env.example .env && docker compose --profile dev up -d`.
#
# В проде /opt/kinopap/.env создаётся и поддерживается bin/deploy.sh, и значения
# там другие (порт базы 5433, redis системный). Общее у них одно: секреты живут
# только в .env. В репозитории их нет — он публичный.

# --- База ---
# Пароль читает docker-compose.yml. Пароль разработчика, не боевой.
POSTGRES_PASSWORD=dev
POSTGRES_USER=zal
POSTGRES_DB=zal
# Прод использует 5433 (на сервере 5432 занят чужим контейнером).
POSTGRES_PORT=5432
DATABASE_URL=postgres://zal:dev@localhost:5432/zal

# --- API ---
# Обязателен, минимум 32 символа. Без него API откажется стартовать.
JWT_SECRET=change-me-to-a-long-random-string-32-chars
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Относительный путь: медиа отдаёт nginx из MEDIA_ROOT. Абсолютный http://
# на HTTPS-странице браузер блокирует как mixed content.
MEDIA_BASE_URL=/media
# Доверять X-Forwarded-For. По умолчанию выключено (безопасный дефолт:
# подделкой заголовка можно обойти per-IP rate limit). Включайте (=1),
# только если API стоит за nginx/прокси и клиенты приходят через него.
TRUST_PROXY=0
# Официальный ключ themoviedb.org — постеры, описания, рейтинги, discovery
TMDB_API_KEY=
# TorrServer (zero-storage стриминг)
TORRSERVER_URL=http://localhost:8090
# Пусто = ссылки на потоки относительные (см. MEDIA_BASE_URL).
TORRSERVER_PUBLIC_URL=
# Подпись ссылок /gst (nginx secure_link). Без него /gst открыт наружу.
# Сгенерировать: openssl rand -hex 32
GST_LINK_SECRET=

# --- Worker (ingest + транскод) ---
# В проде redis системный на 6379; в dev — контейнер из профиля dev на 6380,
# чтобы не спорить с системным.
REDIS_URL=redis://127.0.0.1:6380
MEDIA_ROOT=./data/media
LOCAL_SOURCE_ROOT=./data/sources
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_HLS_TIME=4

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://localhost:3001
# Публичный адрес сайта: metadataBase (OG/канонические URL) и sitemap.
# Пусто = dev-дефолт http://localhost:3000; в проде задать https://<домен>.
NEXT_PUBLIC_SITE_URL=

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:3001

# --- Seed (db:setup) ---
# dev-дефолты; на проде (ZAL_DEPLOY=1) без явных значений владелец не создаётся
SEED_OWNER_EMAIL=owner@zal.local
SEED_OWNER_PASSWORD=change-me-owner

# Прод: число инстансов API в PM2 cluster (1 — один процесс, fork).
API_INSTANCES=2
# Секрет сброса ISR-кэша веба (воркер → POST /api/revalidate). deploy.sh создаёт сам.
REVALIDATE_SECRET=
# Как часто воркер ищет изменившиеся тайтлы для revalidateTag, сек.
REVALIDATE_EVERY_S=120

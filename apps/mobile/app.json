{
  "expo": {
    "name": "Зал",
    "slug": "zal",
    "scheme": "zal",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0b0b0f",
    "plugins": ["expo-router"],
    "ios": { "bundleIdentifier": "dev.zal.mobile", "supportsTablet": true },
    "android": { "package": "dev.zal.mobile" },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}

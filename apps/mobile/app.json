{
  "expo": {
    "name": "Зал",
    "slug": "zal",
    "scheme": "zal",
    "version": "0.0.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0b0b0f",
    "plugins": [
      "expo-router",
      "./plugins/with-android-tv",
      "./plugins/with-dev-cleartext"
    ],
    "ios": { "bundleIdentifier": "dev.zal.mobile", "supportsTablet": true },
    "android": { "package": "dev.zal.mobile" },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}

{
  "uid": "kinopap-main",
  "title": "kino.pap — API",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы в секунду",
      "datasource": {
        "type": "prometheus",
        "uid": "kinopap-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kinopap-prom"
          },
          "expr": "sum by (status) (rate(kinopap_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Доля 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "kinopap-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kinopap-prom"
          },
          "expr": "sum(rate(kinopap_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(kinopap_http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 длительности по маршрутам",
      "datasource": {
        "type": "prometheus",
        "uid": "kinopap-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kinopap-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(kinopap_http_request_duration_ms_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Свежесть фоновых задач",
      "datasource": {
        "type": "prometheus",
        "uid": "kinopap-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kinopap-prom"
          },
          "expr": "kinopap_sync_age_seconds",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Память API",
      "datasource": {
        "type": "prometheus",
        "uid": "kinopap-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kinopap-prom"
          },
          "expr": "kinopap_process_rss_bytes",
          "legendFormat": "rss pm{{pm}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kinopap-prom"
          },
          "expr": "kinopap_process_heap_used_bytes",
          "legendFormat": "heap pm{{pm}}"
        }
      ]
    }
  ]
}